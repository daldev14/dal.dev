---
import IconLink from "@/components/icons/Link.astro";
import { ACHIEVEMENT } from "./data";
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
        ACHIEVEMENT.map((item) => (
            <a
                href={item.href}
                class="relative"
                target="_blank"
                rel="noreferrer noopener"
            >
                <div class="bg-gray-800/50 p-6 rounded-xl hover:bg-gray-800/70 transition">
                    <IconLink class="size-4 absolute right-4 top-2.5" />

                    <h3 class="text-xl font-bold mb-2">{item.title}</h3>
                    <p class="text-gray-400 mb-4">{item.company}</p>
                    <p class="text-gray-300">{item.description}</p>
                </div>
            </a>
        ))
    }
</div>
