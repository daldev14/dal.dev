---
import { ACHIEVEMENT } from "./data";
import IconLink from "@/components/icons/Link.astro";
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
        ACHIEVEMENT.map((item) => (
            <div class="bg-[#0c1117] p-8 rounded-2xl hover:bg-[#0c1117]/80 transition-colors group">
                <h3 class="text-2xl font-bold mb-2">{item.title}</h3>
                <p class="text-gray-400 mb-4">{item.company}</p>
                <p class="text-gray-400 mb-6">{item.description}</p>

                <a
                    href={item.href}
                    class="inline-flex items-center gap-2 px-4 py-2 bg-[#1a2332] rounded-lg hover:bg-[#1a2332]/80 transition-colors text-sm"
                >
                    Ver credencial
                    <IconLink class="size-4" />
                </a>
            </div>
        ))
    }
</div>
